# GeoTrade Backend — Environment Configuration
# Copy to .env and fill in your own keys. NEVER commit a real .env.
#
# All keys are OPTIONAL. With no keys set the API still boots and serves,
# using public no-auth sources (Binance/CoinGecko) for crypto and a clearly
# labelled synthetic feed for other asset classes. Set
# MARKET_DATA_LIVE_ONLY=true to refuse synthetic data instead.

# ========================
# CORE APP
# ========================
# ENV and APP_ENV are both accepted. Must be development | staging | production.
ENV=development
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Comma-separated list of extra allowed CORS origins (your deployed frontend URL)
FRONTEND_URL=

# ========================
# DATABASE (PostgreSQL / TimescaleDB)
# ========================
DATABASE_URL=postgresql+asyncpg://geotrade:geotrade_secret@localhost:5432/geotrade
DATABASE_SYNC_URL=postgresql+psycopg2://geotrade:geotrade_secret@localhost:5432/geotrade
# Use the pooler port (usually 6543) and disable prepared statements on PgBouncer
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ========================
# REDIS + CELERY
# ========================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ========================
# MARKET DATA PROVIDERS (all optional)
# ========================
# Finnhub — primary quotes source. Free tier: https://finnhub.io/
FINNHUB_API_KEY=
FINNHUB_API_KEY_2=

# Twelve Data — forex + commodities. https://twelvedata.com/
TWELVEDATA_API_KEY=

# Alpha Vantage — forex/commodities backup. https://www.alphavantage.co/
ALPHAVANTAGE_API_KEY=

# FRED — macro/bonds. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CoinGecko — crypto, no key required for basic use
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Set true to disable the synthetic fallback (endpoints then 503 without a key)
MARKET_DATA_LIVE_ONLY=false

# ========================
# NEWS
# ========================
NEWSAPI_KEY=

# ========================
# SUPABASE (waitlist)
# ========================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ========================
# EXTERNAL LLM (optional)
# ========================
OPENROUTER_API_KEY=

# ========================
# BROKERAGE CONNECTORS (optional — paper trading by default)
# ========================
# Alpaca — https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# OANDA v20 practice forex
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# CCXT secondary exchange
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_SECRET=
CCXT_SANDBOX=true

# IBKR local Gateway/TWS
IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4001

# SAFETY SWITCH — live orders require BOTH <BROKER>_PAPER=false AND this flag.
# Leave unset unless you fully understand the risk.
# BROKER_LIVE_TRADING=true

# ========================
# TELEMETRY (optional)
# ========================
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=geotrade

# ========================
# ALERT WEBHOOKS (optional)
# ========================
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ========================
# RATE LIMITS (SlowAPI, per IP)
# ========================
# Only RATE_LIMIT_DEFAULT is enforced today (global middleware). SIMULATION is
# read into settings but no route applies it yet — see README "Known limitations".
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SIMULATION=10/minute
