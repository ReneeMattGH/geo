# GeoTrade Frontend — Environment Configuration
# Copy to .env.local for local dev, and set the same keys in the Vercel
# dashboard for production builds.
#
# IMPORTANT: Vite inlines these at BUILD time. Setting them only in the
# runtime environment is not enough — they must exist when `vite build` runs.
# Anything prefixed VITE_ is published into the client bundle: never put a
# secret here. Use the public anon key only.

# Base URL of the deployed backend, including the /api/v1 prefix.
# Local backend example: http://localhost:8000/api/v1
VITE_API_URL=https://geotrade-api.onrender.com/api/v1

# Supabase project used by the waitlist form.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
